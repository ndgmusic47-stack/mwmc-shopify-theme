# Copy to .env and fill in. .env is gitignored: the dispatch point is the
# owner's address and the Google key is billable, so neither belongs in git
# and neither may ever be inlined into the theme.

# Where every delivery leaves from and returns to.
SOS_DISPATCH_POSTCODE=

# Google Maps Platform key with the Routes API enabled and billing active.
GOOGLE_ROUTES_API_KEY=

# Optional.
SOS_COUNTRY=United Kingdom
SOS_ROUTE_CACHE_TTL=604800
