# Copy to .env and fill in. .env is gitignored: the dispatch point is the
# owner's address and an API key is yours alone, so neither belongs in git
# and neither may ever be inlined into the theme.

# Where every delivery leaves from and returns to.
SOS_DISPATCH_POSTCODE=

# OpenRouteService — the default provider. A free key from
# openrouteservice.org/dev/#/signup: email address, no card.
ORS_API_KEY=

# Google Routes — only needed with --provider=google. Requires a Google Cloud
# billing account, which is the step that tends to go wrong.
GOOGLE_ROUTES_API_KEY=

# Optional.
SOS_COUNTRY=United Kingdom
SOS_ROUTE_CACHE_TTL=604800
