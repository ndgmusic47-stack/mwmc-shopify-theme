

<div
  class="page-content{% if page.handle == 'delivery-and-guarantee' %} sos-delivery-content{% endif %}"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {%- if page.handle == 'delivery-and-guarantee' -%}
      {{ page.content
        | replace: '<h3>Collect free in London</h3>', '<h3 id="collection">Collect free in London</h3>'
        | replace: 'That is the price Shopify charges at checkout.', 'Shopify confirms the final delivery charge after you enter your address at checkout.' }}
    {%- else -%}
      {{ page.content }}
    {%- endif -%}
  </rte-formatter>
</div>

{% stylesheet %}
  .page-content {
    color: var(--color, inherit);
  }

  .page-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "class": "rte",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
