      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>What we're for</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "",
