            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>We'll email you when a new date is confirmed. Unsubscribe any time.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "form": {
          "type": "email-signup",
          "settings": {
            "width": "custom",
            "custom_width": 60,
            "style_class": "button",
            "display_type": "text",
            "label": "Sign up",
            "integrated_button": false,
            "border_style": "all",
            "input_style": "default",
            "border_width": 2,
            "border_radius": 8,
            "input_type_preset": "paragraph",
            "button_type_preset": "paragraph",
            "heading_preset": "h4",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "block_order": [
        "anchor",
        "heading",
        "body",
        "form"
      ]
    }
  },
  "order": [
    "intro",
