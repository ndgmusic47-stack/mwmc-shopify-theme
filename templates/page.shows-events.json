    "attending": {
      "type": "section",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 28,
        "section_width": "page-width",
        "section_height": "",
        "section_height_custom": 50,
        "background_media": "none",
        "video_position": "cover",
        "background_image_position": "cover",
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_color": "",
        "border_radius": 0,
        "padding-block-start": 72,
        "padding-block-end": 72,
        "background_color": "{{ settings.color_palette.color2 }}"
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Coming to see us?</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "accordion": {
          "type": "accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "type_preset": "h5",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "row_1": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Can I sell to you at a show?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Bring what you'd like us to look at and we'll go through it with you. The same things decide an offer at a table as online: condition, authenticity, demand and current market value. If you'd rather get an answer before you travel, send us the details first.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  }
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_2": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What will you have on the table?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Singles, sealed product and graded cards — the same stock you'll find online, plus whatever has come in too recently to be listed.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  }
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_3": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Can I collect an online order at a show?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Ask us before you order and we'll tell you what's possible for that particular date. It depends on the event and on what we're able to bring with us, so we'd rather confirm it with you directly than promise it here.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  }
                }
              },
              "block_order": [
                "text"
              ]
            },
            "row_4": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Which payment methods do you take at events?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Ask us ahead of a show and we'll confirm what we'll be able to take on the day. We'd rather tell you directly than list something here that turns out not to be available at a particular venue.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  }
                }
              },
              "block_order": [
                "text"
              ]
            }
          },
          "block_order": [
            "row_1",
            "row_2",
            "row_3",
            "row_4"
          ]
        }
      },
      "block_order": [
        "heading",
        "accordion"
      ]
    },
