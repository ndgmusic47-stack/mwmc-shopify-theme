    "intro": {
      "type": "section",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "section_height": "",
        "section_height_custom": 50,
        "background_media": "none",
        "video_position": "cover",
        "background_image_position": "cover",
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_color": "",
        "border_radius": 0,
        "padding-block-start": 64,
        "padding-block-end": 64,
        "background_color": "{{ settings.color_palette.color1 }}"
      },
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>Shows &amp; events</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h6",
            "font": "var(--font-body--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "name": "t:names.caption"
        },
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h1>Where to find us</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "font": "var(--font-body--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>We take a table at UK card shows and events. It's the best way to go through the binders properly, talk cards with someone who actually collects, and get an opinion on something you've brought with you.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "block_order": [
        "eyebrow",
        "heading",
        "body"
      ]
    },
