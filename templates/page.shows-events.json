                    "style_class": "button",
                    "width": "fit-content",
                    "custom_width": 100,
                    "width_mobile": "fit-content",
                    "custom_width_mobile": 100
                  }
                },
                "b": {
                  "type": "button",
                  "settings": {
                    "label": "Shop online instead",
