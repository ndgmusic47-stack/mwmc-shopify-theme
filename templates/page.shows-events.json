        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Get our show dates</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "",
