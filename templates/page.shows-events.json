          "blocks": {
            "icon": {
              "type": "icon",
              "settings": {
                "icon": "map_pin",
                "width": 40,
                "link": ""
              }
            },
            "title": {
              "type": "text",
              "settings": {
                "text": "<h3>New dates coming soon</h3>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h4",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "body": {
              "type": "text",
              "settings": {
                "text": "<p>We haven't got a confirmed date in the diary right now. As soon as one is booked it'll be listed here — sign up below and we'll email you when it is.</p>",
                "width": "100%",
                "max_width": "narrow",
                "alignment": "center",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
