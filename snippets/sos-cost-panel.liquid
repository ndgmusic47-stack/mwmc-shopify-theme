{% comment %}
  The whole cost of owning the piece, worked out before Add to bag.

  Two groups, because only two things are true:

    Paid at checkout   the statue, delivery if they want it, and assembly.
                       All three are real charges Shopify takes.
    Arranged later     box storage. The first month is free from the day we
                       collect the box, so there is nothing to pay today and
                       nothing to pretend about.

  Assembly is a real product (handle in-home-assembly) added to the basket as
  its own line, so the figure on this panel is the figure Shopify charges.

  Usage: {% render 'sos-cost-panel', product: product, enquiry_page: s.enquiry_page %}
{% endcomment %}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign enquiry = enquiry_page | default: '/pages/contact'
  assign assembly = all_products['in-home-assembly']
  assign assembly_variant = assembly.selected_or_first_available_variant
-%}

<div
  class="sos-costs"
  data-sos-costs
  data-zones="{{ 'sos-delivery-zones.json' | asset_url }}"
  data-price="{{ v.price }}"
  data-variant="{{ v.id }}"
  data-piece="{{ product.title | escape }}"
  data-enquiry="{{ enquiry }}"
  {% if assembly_variant and assembly.available %}
    data-assembly-variant="{{ assembly_variant.id }}"
    data-assembly-price="{{ assembly_variant.price }}"
  {% endif %}
>
  <h2 class="sos-costs__h">What it costs to get it home</h2>

  <fieldset class="sos-costs__group">
    <legend class="sos-costs__legend">How would you like to receive it?</legend>

    <label class="sos-costs__row">
      <input type="radio" name="sos-method" value="collection" checked data-sos-method>
      <span class="sos-costs__rowBody">
        <span class="sos-costs__rowName">Collect it from us in London</span>
        <span class="sos-costs__rowNote">Free, and usually ready within 24 hours.</span>
      </span>
      <span class="sos-costs__rowPrice">Free</span>
    </label>

    <label class="sos-costs__row">
      <input type="radio" name="sos-method" value="delivery" data-sos-method>
      <span class="sos-costs__rowBody">
        <span class="sos-costs__rowName">We bring it to you</span>
        <span class="sos-costs__rowNote">One of us drives it to your door and carries it in.</span>
      </span>
      <span class="sos-costs__rowPrice" data-sos-delivery-price>Tell us where</span>
    </label>
  </fieldset>

  <div class="sos-costs__postcode" data-sos-postcode-row hidden>
    <label class="sos-field__label" for="sos-postcode-{{ product.id }}">Where are we bringing it?</label>
    <div class="sos-costs__postcodeRow">
      <input
        id="sos-postcode-{{ product.id }}"
        class="sos-input"
        type="text"
        inputmode="text"
        autocomplete="postal-code"
        placeholder="Your postcode, e.g. M1 1AE"
        data-sos-postcode>
      <button type="button" class="sos-btn sos-btn--ghost" data-sos-postcode-go>Get my price</button>
    </div>
    <p class="sos-costs__msg" data-sos-postcode-msg role="status"></p>
  </div>

  <fieldset class="sos-costs__group sos-costs__group--extras">
    <legend class="sos-costs__legend">Would you like either of these? Both are optional.</legend>

    {%- if assembly_variant and assembly.available -%}
      <label class="sos-costs__row">
        <input type="checkbox" data-sos-extra="assembly">
        <span class="sos-costs__rowBody">
          <span class="sos-costs__rowName">Have us set it up for you</span>
          <span class="sos-costs__rowNote">We unbox it, assemble it, and put it exactly where you want it before we leave. Added to this order and paid with it.</span>
        </span>
        <span class="sos-costs__rowPrice">{{ assembly_variant.price | money }}</span>
      </label>
    {%- endif -%}

    <label class="sos-costs__row">
      <input type="checkbox" data-sos-extra="storage">
      <span class="sos-costs__rowBody">
        <span class="sos-costs__rowName">Let us keep the box</span>
        <span class="sos-costs__rowNote">Original boxes are bulky and worth keeping. We store yours and bring it back whenever you want it. Your first month is free from the day we collect it, then £19.99 a month. We will confirm everything in writing before a penny is charged, and you can stop any time.</span>
      </span>
      <span class="sos-costs__rowPrice">Free<span class="sos-costs__rowPriceSub">first month</span></span>
    </label>
  </fieldset>

  <dl class="sos-costs__total" data-sos-summary>
    <div class="sos-costs__line">
      <dt>{{ product.title }}</dt>
      <dd>{{ v.price | money }}</dd>
    </div>
    <div class="sos-costs__line" data-sos-line="delivery" hidden>
      <dt>Personal delivery <span class="sos-costs__when" data-sos-delivery-where></span></dt>
      <dd data-sos-amount="delivery">—</dd>
    </div>
    <div class="sos-costs__line" data-sos-line="assembly" hidden>
      <dt>Setting it up for you</dt>
      <dd data-sos-amount="assembly">—</dd>
    </div>
    <div class="sos-costs__line sos-costs__line--due">
      <dt>You pay today</dt>
      <dd data-sos-amount="due">{{ v.price | money }}</dd>
    </div>
    <div class="sos-costs__line sos-costs__line--later" data-sos-line="storage" hidden>
      <dt>Box storage <span class="sos-costs__when">nothing today — £19.99 a month from month two</span></dt>
      <dd data-sos-amount="storage">£0.00</dd>
    </div>
  </dl>

  {%- comment -%}
    Carried into the basket and the order so the choices survive checkout.
    Storage is a request, so it is labelled as one.
  {%- endcomment -%}
  <input type="hidden" name="properties[Fulfilment]" value="Collection in London" data-sos-prop="method" form="sos-add">
  <input type="hidden" name="properties[Delivery postcode]" value="" data-sos-prop="postcode" form="sos-add" disabled>
  <input type="hidden" name="properties[Box storage]" value="" data-sos-prop="storage" form="sos-add" disabled>

  <p class="sos-costs__foot">
    Delivery is priced on the round trip from our London base, so you pay the
    same whatever the piece costs. <a href="/pages/delivery-and-guarantee">See every price band</a>.
  </p>
</div>
