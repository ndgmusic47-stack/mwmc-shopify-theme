{% comment %}
  Sultan of Statues: approved Extraordinary hero artwork.
  Artwork and bespoke typography remain intact as a single supplied image.
{% endcomment %}

<section class="sos-extraordinary" aria-labelledby="sos-extraordinary-title-{{ section.id }}">
  <h1 class="sos-extraordinary__sr" id="sos-extraordinary-title-{{ section.id }}">
    Make room for the extraordinary.
  </h1>

  <div class="sos-extraordinary__stage">
    <picture>
      <source media="(max-width: 700px)" type="image/webp" width="1000" height="1000"
              srcset="{{ 'sos-hero-extraordinary-mobile.webp' | asset_url }}">
      <source type="image/webp"
              srcset="{{ 'sos-hero-extraordinary-860.webp' | asset_url }} 860w, {{ 'sos-hero-extraordinary-1672.webp' | asset_url }} 1672w"
              sizes="100vw">
      <img class="sos-extraordinary__art"
           src="{{ 'sos-hero-extraordinary.png' | asset_url }}"
           alt="A Sultan statue holding a red dragon beside a swirling blue display of anime statues."
           width="1672" height="941"
           loading="eager" fetchpriority="high" decoding="async">
    </picture>

  </div>
</section>

{% stylesheet %}
.sos-extraordinary { background: #10121c; width: 100%; }
.sos-extraordinary__sr {
  position: absolute !important;
  width: 1px !important; height: 1px !important;
  padding: 0 !important; margin: -1px !important;
  overflow: hidden !important; clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important; border: 0 !important;
}
.sos-extraordinary__stage { position: relative; width: 100%; }
.sos-extraordinary__stage picture { display: block; width: 100%; }
.sos-extraordinary__art { display: block; width: 100%; height: auto; }
@media (max-width: 700px) { .sos-extraordinary__art { aspect-ratio: 1; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Extraordinary hero",
  "tag": "div",
  "class": "sos-extraordinary-section",
  "presets": [{ "name": "Extraordinary hero" }]
}
{% endschema %}
