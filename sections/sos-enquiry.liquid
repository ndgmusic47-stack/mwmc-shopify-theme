{% comment %}
  Sultan of Statues — enquiry form. Uses Shopify's native contact form, so
  submissions reach the store's existing contact destination. Fields are
  statue-specific. Nothing is promised about outcome or timescale.
{% endcomment %}
{%- assign s = section.settings -%}
<div class="sos">
  <section class="sos-enquiry" id="{{ s.anchor | default: 'enquiry' }}">
    <div class="sos-wrap sos-enquiry__inner">
      <div class="sos-enquiry__intro">
        {%- if s.eyebrow != blank -%}<p class="sos-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sos-display sos-enquiry__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<div class="sos-prose__body">{{ s.body }}</div>{%- endif -%}
        {%- if s.note != blank -%}<p class="sos-enquiry__note">{{ s.note }}</p>{%- endif -%}
      </div>

      <div class="sos-enquiry__formwrap">
        {%- form 'contact', class: 'sos-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="sos-form__ok">{{ s.success | default: 'Thank you — your enquiry has been sent.' }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="sos-form__err">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <div class="sos-form__row">
            <label for="sos-name-{{ section.id }}">Name</label>
            <input id="sos-name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
          </div>
          <div class="sos-form__row">
            <label for="sos-email-{{ section.id }}">Email</label>
            <input id="sos-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          {%- if s.show_location -%}
            <div class="sos-form__row">
              <label for="sos-loc-{{ section.id }}">Where are you based?</label>
              <input id="sos-loc-{{ section.id }}" type="text" name="contact[Location]">
            </div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <div class="sos-form__row" {{ block.shopify_attributes }}>
              <label for="sos-f{{ forloop.index }}-{{ section.id }}">{{ block.settings.label }}</label>
              <input id="sos-f{{ forloop.index }}-{{ section.id }}" type="text" name="contact[{{ block.settings.label }}]" placeholder="{{ block.settings.hint | escape }}">
            </div>
          {%- endfor -%}
          <div class="sos-form__row">
            <label for="sos-msg-{{ section.id }}">{{ s.message_label }}</label>
            <textarea id="sos-msg-{{ section.id }}" name="contact[body]" rows="6" placeholder="{{ s.message_hint | escape }}"></textarea>
          </div>
          <button type="submit" class="sos-btn sos-btn--primary">{{ s.submit | default: 'Send enquiry' }}{% render 'sos-icon', name: 'arrow' %}</button>
          {%- if s.photo_note != blank -%}<p class="sos-form__hint">{{ s.photo_note }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Enquiry form", "tag": "section", "class": "sos-enquiry-section", "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "enquiry" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "note", "label": "Commitment note", "default": "Sending an enquiry does not commit you to anything." },
    { "type": "checkbox", "id": "show_location", "label": "Ask where they are based", "default": true },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Tell us about the piece" },
    { "type": "text", "id": "message_hint", "label": "Message placeholder" },
    { "type": "text", "id": "photo_note", "label": "Photo note" },
    { "type": "text", "id": "submit", "label": "Submit label", "default": "Send enquiry" },
    { "type": "text", "id": "success", "label": "Success message" }
  ],
  "blocks": [{ "type": "field", "name": "Extra field", "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "hint", "label": "Placeholder" }
  ]}],
  "presets": [{ "name": "Enquiry form" }]
}
{% endschema %}
