{% comment %}
  Sultan of Statues — page banner.

  On a collection, the collection's own title and description win. One
  collection template serves every collection, so hard-coding the heading
  here would put one collection's name on all of them; this way the H1 and
  the intro are edited in Shopify, next to the collection's SEO fields,
  and the section settings are only the fallback.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign ph_heading = s.heading | default: page.title
  assign ph_body = s.body

  comment
    "all" is Shopify's catch-all route, not a curated collection: its title
    is the generic "Products". Leave that one on the section settings.
  endcomment
  if s.use_collection and collection != blank and collection.handle != blank and collection.handle != 'all'
    if collection.title != blank
      assign ph_heading = collection.title
    endif
    if collection.description != blank
      assign ph_body = collection.description
    endif
  endif
-%}

<div class="sos">
  <section class="sos-pagehero{% if section.settings.dark %} sos-pagehero--dark{% endif %}">
    <div class="sos-wrap sos-pagehero__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="sos-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="sos-display sos-pagehero__title">{{ ph_heading }}</h1>
      {%- if ph_body != blank -%}<div class="sos-lede sos-pagehero__lede">{{ ph_body }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="sos-pagehero__actions">
          <a class="sos-btn sos-btn--primary" href="{{ section.settings.button_link | default: routes.root_url }}">
            {{ section.settings.button_label }}{% render 'sos-icon', name: 'arrow' %}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Page banner", "tag": "section", "class": "sos-pagehero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Supporting line" },
    { "type": "checkbox", "id": "use_collection", "label": "On a collection, use its own title and description", "default": true },
    { "type": "paragraph", "content": "Leave this ticked on the collection template. The heading and intro then come from the collection in Shopify, beside its SEO fields, and the two settings above are only the fallback." },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "dark", "label": "Espresso background", "default": false }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}
