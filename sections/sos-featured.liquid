{% comment %}
  Sultan of Statues — featured piece.

  INTERIM TREATMENT, per claude-handoff/CLAUDE-NEXT.md item 3.

  The genuine seller photograph is presented whole, in a restrained editorial
  panel beside the architectural setting. It is deliberately NOT composited
  onto the pedestal in the hero plate, there is no decorative arch around it,
  and the image is contained rather than cropped — the source already loses
  some effects and part of the base, and no pixels are synthesised to replace
  them.

  This section is replaced by the integrated hero once a faithful cutout or a
  full uncropped source exists.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign img = ''
  if s.image == blank and s.image_asset != blank
    assign img = s.image_asset | asset_url
  endif
-%}

<div class="sos">
  <section class="sos-featured">
    <div class="sos-wrap">
      <div class="sos-featured__grid">

        <div class="sos-featured__frame">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1600 | image_tag:
                 widths: '600, 900, 1200, 1600',
                 sizes: '(max-width: 1000px) 92vw, 52vw',
                 loading: 'lazy',
                 alt: s.image_alt }}
          {%- elsif img != blank -%}
            <img src="{{ img }}"
                 alt="{{ s.image_alt | escape }}"
                 width="{{ s.image_width }}" height="{{ s.image_height }}"
                 loading="lazy" decoding="async">
          {%- endif -%}
        </div>

        <div class="sos-featured__body">
          {%- if s.eyebrow != blank -%}
            <p class="sos-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}

          {%- if s.name != blank -%}
            <h2 class="sos-display sos-featured__name">{{ s.name }}</h2>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <dl class="sos-featured__specs">
              {%- for block in section.blocks -%}
                <div {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.label }}</dt>
                  <dd>{{ block.settings.value }}</dd>
                </div>
              {%- endfor -%}
            </dl>
          {%- endif -%}

          {%- if s.note != blank -%}
            <p class="sos-featured__note">{{ s.note }}</p>
          {%- endif -%}

          {%- if s.button_label != blank -%}
            <div class="sos-featured__actions">
              <a class="sos-btn sos-btn--ghost" href="{{ s.button_link | default: routes.all_products_collection_url }}">
                {{ s.button_label }}
                {% render 'sos-icon', name: 'arrow' %}
              </a>
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Featured piece",
  "tag": "section",
  "class": "sos-featured-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Photograph" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_asset", "label": "Or a theme asset filename", "default": "sos-statue-luffy-gear5.webp" },
    { "type": "number", "id": "image_width", "label": "Intrinsic width (px)", "default": 1600 },
    { "type": "number", "id": "image_height", "label": "Intrinsic height (px)", "default": 1188 },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Gear 5 Luffy resin statue, seller photograph" },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The featured piece" },
    { "type": "text", "id": "name", "label": "Name", "default": "Gear 5 Luffy" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Photographed by the seller. Shown here as a standalone study while the integrated showroom composite is prepared." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Enquire about this piece" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Scale" },
        { "type": "text", "id": "value", "label": "Value", "default": "1/6" }
      ]
    }
  ],
  "presets": [{ "name": "Featured piece" }]
}
{% endschema %}
