{% comment %}
  Sultan of Statues — Modern Palace header.
  Bespoke section. Independent of Savor's stock header; both can coexist.
{% endcomment %}

{%- comment -%} Brand faces, self-hosted. No third-party font request. {%- endcomment -%}
{% style %}
  @font-face { font-family: "Cormorant Garamond"; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'sos-cormorant-400.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Cormorant Garamond"; font-style: normal; font-weight: 500; font-display: swap; src: url({{ 'sos-cormorant-500.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Cormorant Garamond"; font-style: normal; font-weight: 600; font-display: swap; src: url({{ 'sos-cormorant-600.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Cormorant Garamond"; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'sos-cormorant-400-italic.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Cormorant Garamond"; font-style: italic; font-weight: 500; font-display: swap; src: url({{ 'sos-cormorant-500-italic.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Jost"; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'sos-jost-400.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Jost"; font-style: normal; font-weight: 500; font-display: swap; src: url({{ 'sos-jost-500.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Jost"; font-style: normal; font-weight: 600; font-display: swap; src: url({{ 'sos-jost-600.woff2' | asset_url }}) format("woff2"); }
{% endstyle %}
{{ 'sos-palace.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sos-palace.js' | asset_url }}" defer></script>

{%- liquid
  assign menu = section.settings.menu
  assign sticky = section.settings.sticky
-%}

<div class="sos" data-sos-header>
  <header
    class="sos-header"
    {% unless sticky %}style="position: relative;"{% endunless %}
    role="banner"
  >
    <div class="sos-wrap sos-header__bar">

      <a class="sos-logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {{ section.settings.logo
             | image_url: width: 600
             | image_tag:
               class: 'sos-logo__img',
               alt: logo_alt,
               widths: '200, 300, 400, 600',
               style: 'height: ' | append: section.settings.logo_height | append: 'px;' }}
        {%- else -%}
          <span class="sos-logo__word">{{ section.settings.logo_lead }} <em>{{ section.settings.logo_join }}</em> {{ section.settings.logo_tail }}</span>
          <span class="sos-logo__rule" aria-hidden="true"><i></i><b></b><i></i></span>
        {%- endif -%}
      </a>

      {%- if menu != blank and menu.links.size > 0 -%}
        <nav class="sos-nav" aria-label="Primary">
          <ul class="sos-nav__list">
            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                <li class="sos-nav__item" data-sos-dropdown data-open="false">
                  <button
                    type="button"
                    class="sos-nav__link"
                    data-sos-dropdown-trigger
                    aria-expanded="false"
                  >
                    {{ link.title }}
                    {% render 'sos-icon', name: 'caret' %}
                  </button>
                  <ul class="sos-nav__panel">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </li>
              {%- else -%}
                <li class="sos-nav__item">
                  <a class="sos-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- else -%}
        <span></span>
      {%- endif -%}

      <div class="sos-utils">
        {%- if section.settings.show_search -%}
          <a class="sos-util" href="{{ routes.search_url }}">
            {% render 'sos-icon', name: 'search' %}
            <span class="sos-visually-hidden">Search</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a class="sos-util" href="{{ routes.account_url }}">
            {% render 'sos-icon', name: 'account' %}
            <span class="sos-visually-hidden">Account</span>
          </a>
        {%- endif -%}

        <a class="sos-util" href="{{ routes.cart_url }}">
          {% render 'sos-icon', name: 'bag' %}
          {%- if cart.item_count > 0 -%}
            <span class="sos-util__count">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="sos-visually-hidden">Bag</span>
        </a>

        <button type="button" class="sos-util sos-burger" data-sos-drawer-open>
          {% render 'sos-icon', name: 'menu', size: 22 %}
          <span class="sos-visually-hidden">Menu</span>
        </button>
      </div>

    </div>
  </header>

  <div class="sos-drawer" data-sos-drawer data-open="false" aria-hidden="true">
    <div class="sos-drawer__scrim" data-sos-drawer-close></div>
    <div class="sos-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="sos-drawer__head">
        <span class="sos-logo__word" style="font-size: 1.1rem;">
          {{ section.settings.logo_lead }} <em>{{ section.settings.logo_join }}</em> {{ section.settings.logo_tail }}
        </span>
        <button type="button" class="sos-util" data-sos-drawer-close>
          {% render 'sos-icon', name: 'close', size: 22 %}
          <span class="sos-visually-hidden">Close</span>
        </button>
      </div>

      {%- if menu != blank and menu.links.size > 0 -%}
        <ul class="sos-drawer__list">
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <ul class="sos-drawer__sub">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Palace header",
  "tag": "section",
  "class": "sos-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 46 },
    { "type": "paragraph", "content": "Leave the logo image empty to use the typographic wordmark below." },
    { "type": "text", "id": "logo_lead", "label": "Wordmark — first word", "default": "Sultan" },
    { "type": "text", "id": "logo_join", "label": "Wordmark — joining word", "default": "of" },
    { "type": "text", "id": "logo_tail", "label": "Wordmark — last word", "default": "Statues" },

    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },

    { "type": "header", "content": "Options" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top on scroll", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
