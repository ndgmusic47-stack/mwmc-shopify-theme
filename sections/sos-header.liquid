{% comment %}
  Sultan of Statues — Modern Palace header.
  Bespoke section. Independent of Savor's stock header; both can coexist.
{% endcomment %}

{%- comment -%}
  Cal Sans, self-hosted. One variable file carries weight 400-700 and optical
  size 8-45, which is where the hierarchy between statue names, prices and
  supporting text comes from — no second family needed.
  SIL Open Font License 1.1; licence shipped alongside as sos-calsans-OFL.txt.
{%- endcomment -%}
{% style %}
  @font-face {
    font-family: "Cal Sans";
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url({{ 'sos-calsans.woff2' | asset_url }}) format("woff2-variations"),
         url({{ 'sos-calsans.woff2' | asset_url }}) format("woff2");
  }
{% endstyle %}
{{ 'sos-calsans.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'sos-palace.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sos-palace.js' | asset_url }}" defer></script>

{%- liquid
  assign menu = section.settings.menu
  assign sticky = section.settings.sticky

  comment
    Navigation source. The shared Shopify menus (main-menu, footer) are
    store-level and still carry the card-shop and consignment links, so the
    theme owns its own navigation by default. Switch nav_source to "shopify"
    only after the live menus have been rewritten.
  endcomment
  assign nav_items = section.blocks | where: 'type', 'nav_item'
  assign use_theme_nav = false
  if section.settings.nav_source == 'theme' and nav_items.size > 0
    assign use_theme_nav = true
  endif
-%}

<div class="sos" data-sos-header>
  <header
    class="sos-header"
    {% unless sticky %}style="position: relative;"{% endunless %}
    role="banner"
  >
    <div class="sos-wrap sos-header__bar">

      {%- liquid
        assign mode = section.settings.logo_mode
        if mode == 'image' and section.settings.logo == blank
          assign mode = 'wordmark'
        endif
        assign emblem_src = ''
        if section.settings.emblem != blank
          assign emblem_src = section.settings.emblem | image_url: width: 320
        elsif section.settings.emblem_asset != blank
          assign emblem_src = section.settings.emblem_asset | asset_url
        endif
        if mode == 'lockup' and emblem_src == blank
          assign mode = 'wordmark'
        endif
        assign logo_class = 'sos-logo'
        if mode == 'lockup'
          assign logo_class = 'sos-logo sos-logo--lockup'
        endif
      -%}

      <a class="{{ logo_class }}" href="{{ routes.root_url }}">
        {%- case mode -%}

          {%- when 'image' -%}
            {%- assign logo_alt = shop.name | escape -%}
            {{ section.settings.logo
               | image_url: width: 900
               | image_tag:
                 class: 'sos-logo__img',
                 alt: logo_alt,
                 widths: '200, 300, 450, 600, 900',
                 style: 'height: ' | append: section.settings.logo_height | append: 'px;' }}

          {%- when 'lockup' -%}
            {%- if section.settings.emblem != blank -%}
              {{ section.settings.emblem
                 | image_url: width: 320
                 | image_tag:
                   class: 'sos-logo__emblem',
                   alt: '',
                   widths: '80, 120, 160, 240, 320',
                   style: 'height: ' | append: section.settings.emblem_height | append: 'px;' }}
            {%- else -%}
              {%- comment -%}
                The Sultan emblem, cut out of its black plate. 1x/2x/3x so it
                stays sharp on high-density screens; intrinsic size is the 1x
                asset and CSS controls the rendered height.
              {%- endcomment -%}
              <img
                class="sos-logo__emblem"
                src="{{ 'sos-emblem.png' | asset_url }}"
                srcset="{{ 'sos-emblem.png' | asset_url }} 1x, {{ 'sos-emblem@2x.png' | asset_url }} 2x, {{ 'sos-emblem@3x.png' | asset_url }} 3x"
                alt=""
                width="82"
                height="72"
                style="height: {{ section.settings.emblem_height }}px;"
                loading="eager"
                fetchpriority="high"
                decoding="async">
            {%- endif -%}
            <span class="sos-logo__stack">
              <span class="sos-logo__word">{{ section.settings.logo_lead }} <em>{{ section.settings.logo_join }}</em> {{ section.settings.logo_tail }}</span>
              <span class="sos-logo__rule" aria-hidden="true"><i></i><b></b><i></i></span>
            </span>

          {%- else -%}
            <span class="sos-logo__word">{{ section.settings.logo_lead }} <em>{{ section.settings.logo_join }}</em> {{ section.settings.logo_tail }}</span>
            <span class="sos-logo__rule" aria-hidden="true"><i></i><b></b><i></i></span>

        {%- endcase -%}
      </a>

      {%- if use_theme_nav -%}
        <nav class="sos-nav" aria-label="Primary">
          <ul class="sos-nav__list">
            {%- for block in nav_items -%}
              <li class="sos-nav__item" {{ block.shopify_attributes }}>
                <a class="sos-nav__link" href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- elsif menu != blank and menu.links.size > 0 -%}
        <nav class="sos-nav" aria-label="Primary">
          <ul class="sos-nav__list">
            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                <li class="sos-nav__item" data-sos-dropdown data-open="false">
                  <button
                    type="button"
                    class="sos-nav__link"
                    data-sos-dropdown-trigger
                    aria-expanded="false"
                  >
                    {{ link.title }}
                    {% render 'sos-icon', name: 'caret' %}
                  </button>
                  <ul class="sos-nav__panel">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </li>
              {%- else -%}
                <li class="sos-nav__item">
                  <a class="sos-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- else -%}
        <span></span>
      {%- endif -%}

      <div class="sos-utils">
        {%- if section.settings.show_search -%}
          <a class="sos-util" href="{{ routes.search_url }}">
            {% render 'sos-icon', name: 'search' %}
            <span class="sos-visually-hidden">Search</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a class="sos-util" href="{{ routes.account_url }}">
            {% render 'sos-icon', name: 'account' %}
            <span class="sos-visually-hidden">Account</span>
          </a>
        {%- endif -%}

        <a class="sos-util" href="{{ routes.cart_url }}">
          {% render 'sos-icon', name: 'bag' %}
          {%- if cart.item_count > 0 -%}
            <span class="sos-util__count">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="sos-visually-hidden">Bag</span>
        </a>

        <button type="button" class="sos-util sos-burger" data-sos-drawer-open>
          {% render 'sos-icon', name: 'menu', size: 22 %}
          <span class="sos-visually-hidden">Menu</span>
        </button>
      </div>

    </div>
  </header>

  <div class="sos-drawer" data-sos-drawer data-open="false" aria-hidden="true">
    <div class="sos-drawer__scrim" data-sos-drawer-close></div>
    <div class="sos-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="sos-drawer__head">
        <span class="sos-logo__word" style="font-size: 1.1rem;">
          {{ section.settings.logo_lead }} <em>{{ section.settings.logo_join }}</em> {{ section.settings.logo_tail }}
        </span>
        <button type="button" class="sos-util" data-sos-drawer-close>
          {% render 'sos-icon', name: 'close', size: 22 %}
          <span class="sos-visually-hidden">Close</span>
        </button>
      </div>

      {%- if use_theme_nav -%}
        <ul class="sos-drawer__list">
          {%- for block in nav_items -%}
            <li><a href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label }}</a></li>
          {%- endfor -%}
        </ul>
      {%- elsif menu != blank and menu.links.size > 0 -%}
        <ul class="sos-drawer__list">
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <ul class="sos-drawer__sub">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Palace header",
  "tag": "section",
  "class": "sos-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    {
      "type": "select",
      "id": "logo_mode",
      "label": "Logo style",
      "options": [
        { "value": "wordmark", "label": "Typographic wordmark" },
        { "value": "lockup", "label": "Emblem + wordmark" },
        { "value": "image", "label": "Uploaded image" }
      ],
      "default": "wordmark"
    },
    { "type": "paragraph", "content": "The supplied logo-wordmark.png is stacked and wide-format, so it is not used in the nav bar. The wordmark here is live text, which stays crisp at every size." },
    { "type": "text", "id": "logo_lead", "label": "Wordmark — first word", "default": "Sultan" },
    { "type": "text", "id": "logo_join", "label": "Wordmark — joining word", "default": "of" },
    { "type": "text", "id": "logo_tail", "label": "Wordmark — last word", "default": "Statues" },
    { "type": "image_picker", "id": "emblem", "label": "Emblem image" },
    { "type": "text", "id": "emblem_asset", "label": "Or an emblem theme asset", "default": "sos-emblem.png" },
    { "type": "range", "id": "emblem_height", "label": "Emblem height", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo image height", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 46 },

    { "type": "header", "content": "Navigation" },
    {
      "type": "select", "id": "nav_source", "label": "Navigation source",
      "options": [
        { "value": "theme", "label": "Theme links (set below)" },
        { "value": "shopify", "label": "Shopify menu" }
      ],
      "default": "theme"
    },
    { "type": "paragraph", "content": "The shared Shopify menus are store-level and still carry the old card-shop and consignment links. Theme links keep staging correct without editing the live menus. Switch to the Shopify menu only once those menus have been rewritten." },
    { "type": "link_list", "id": "menu", "label": "Shopify menu (fallback)", "default": "main-menu" },

    { "type": "header", "content": "Options" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top on scroll", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The Collection" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
