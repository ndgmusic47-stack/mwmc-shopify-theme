{% comment %}
  Sultan of Statues — editorial copy, optionally with numbered steps.

  Optional further-reading link: resolves a handle against the blog's
  articles. blogs[handle].articles lists VISIBLE articles only, so a
  hidden or scheduled article returns nothing and the link does not
  render. That is deliberate — the link can be configured before the
  article is published without ever pointing at a 404, and it appears
  on its own the moment the article goes visible.

  Found by looping rather than `| where: 'handle', ... | first`. The
  where filter returned nothing against blog.articles on the live
  storefront — it is a lazy article collection, not a plain array, so
  array filters are not dependable on it. A for loop is.

  Caveat for later: outside a paginate tag blog.articles returns the
  first 50 articles, so once a blog passes 50 posts a link to an older
  one would silently stop rendering. Fine at one article; revisit if
  the series ever gets that long.
{% endcomment %}
{%- liquid
  assign sos_further = null
  if section.settings.article_handle != blank
    assign sos_blog = section.settings.article_blog | default: 'news'
    for sos_a in blogs[sos_blog].articles
      if sos_a.handle == section.settings.article_handle
        assign sos_further = sos_a
        break
      endif
    endfor
  endif
-%}
<div class="sos">
  <section class="sos-prose{% if section.settings.tint %} sos-prose--tint{% endif %}">
    <div class="sos-wrap">
      {%- if section.settings.collapsible and section.settings.heading != blank -%}
        <details class="sos-editorial-details">
          <summary>{{ section.settings.heading | escape }}</summary>
          <div class="sos-editorial-details__body">
      {%- else -%}
      {%- if section.settings.eyebrow != blank -%}<p class="sos-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sos-display sos-prose__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- endif -%}
      {%- if section.settings.body != blank -%}<div class="sos-prose__body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ol class="sos-steps">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="sos-steps__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <h3 class="sos-steps__h">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p class="sos-steps__p">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="sos-prose__actions">
          <a class="sos-btn sos-btn--ghost" href="{{ section.settings.button_link | default: routes.root_url }}">
            {{ section.settings.button_label }}{% render 'sos-icon', name: 'arrow' %}
          </a>
        </div>
      {%- endif -%}
      {%- if sos_further != blank -%}
        <div class="sos-prose__actions">
          <a class="sos-textlink" href="{{ sos_further.url }}">
            {{ section.settings.article_label | default: sos_further.title }}
            {% render 'sos-icon', name: 'arrow' %}
          </a>
        </div>
      {%- endif -%}
      {%- if section.settings.collapsible and section.settings.heading != blank -%}
          </div>
        </details>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Editorial copy", "tag": "section", "class": "sos-prose-section", "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "collapsible", "label": "Show as a dropdown", "default": false },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false },
    { "type": "header", "content": "Further reading" },
    { "type": "text", "id": "article_handle", "label": "Article handle", "info": "Links to a blog article. The link only appears once that article is visible, so it can be set up in advance." },
    { "type": "text", "id": "article_blog", "label": "Blog handle", "default": "news" },
    { "type": "text", "id": "article_label", "label": "Link label", "info": "Defaults to the article title." }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ]}],
  "presets": [{ "name": "Editorial copy" }]
}
{% endschema %}
