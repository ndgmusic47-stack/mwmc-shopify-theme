{% comment %}
  Sultan of Statues — palace hero.

  The supplied photographic plate is the architectural setting. The genuine
  seller photograph of the featured piece is mounted as a display panel
  standing on the plate's own stone pedestal, with a contact shadow.

  The product photograph is used whole and unaltered: no cutout, no mask, no
  redrawn or synthesised pixels. See the masking blocker reported alongside
  this build.

  Headline, supporting line and CTA are live HTML. Nothing is baked into art.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign dw = s.desktop_widths | split: ','
  assign mw = s.mobile_widths | split: ','
  assign pw = s.piece_widths | split: ','
-%}

<div class="sos">
  <section class="sos-hero">

    <div class="sos-hero__media">
      <picture>
        {%- if s.mobile_stem != blank -%}
          <source media="(max-width: 1000px)" type="image/avif" srcset="
            {%- for w in mw -%}{{ s.mobile_stem | append: '-' | append: w | append: '.avif' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="100vw">
          <source media="(max-width: 1000px)" type="image/webp" srcset="
            {%- for w in mw -%}{{ s.mobile_stem | append: '-' | append: w | append: '.webp' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="100vw">
          <source media="(max-width: 1000px)" srcset="{{ s.mobile_stem | append: '-' | append: mw.last | append: '.jpg' | asset_url }}">
        {%- endif -%}
        <source type="image/avif" srcset="
          {%- for w in dw -%}{{ s.desktop_stem | append: '-' | append: w | append: '.avif' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="100vw">
        <source type="image/webp" srcset="
          {%- for w in dw -%}{{ s.desktop_stem | append: '-' | append: w | append: '.webp' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="100vw">
        <img src="{{ s.desktop_stem | append: '-' | append: dw.last | append: '.jpg' | asset_url }}"
             alt="{{ s.plate_alt | escape }}"
             width="{{ s.plate_width }}" height="{{ s.plate_height }}"
             fetchpriority="high" decoding="async"
             style="--sos-hero-focus: {{ s.focal_point }};">
      </picture>

      {%- if s.plate_caption != blank -%}
        <p class="sos-hero__plaque">{{ s.plate_caption }}</p>
      {%- endif -%}

      {%- if s.piece_stem != blank -%}
        <div class="sos-hero__piece"
             style="--piece-x: {{ s.piece_x }}%; --piece-bottom: {{ s.piece_bottom }}%; --piece-w: {{ s.piece_w }}%; --piece-x-m: {{ s.piece_x_m }}%; --piece-bottom-m: {{ s.piece_bottom_m }}%; --piece-w-m: {{ s.piece_w_m }}%;">
          <figure>
            <picture>
              <source type="image/avif" srcset="
                {%- for w in pw -%}{{ s.piece_stem | append: '-' | append: w | append: '.avif' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="(max-width: 1000px) 62vw, 30vw">
              <source type="image/webp" srcset="
                {%- for w in pw -%}{{ s.piece_stem | append: '-' | append: w | append: '.webp' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="(max-width: 1000px) 62vw, 30vw">
              <img src="{{ s.piece_stem | append: '-' | append: pw.last | append: '.jpg' | asset_url }}"
                   alt="{{ s.piece_alt | escape }}"
                   width="{{ s.piece_width }}" height="{{ s.piece_height }}"
                   fetchpriority="high" decoding="async">
            </picture>
            {%- if s.piece_caption != blank -%}
              <figcaption class="sos-hero__caption">{{ s.piece_caption }}</figcaption>
            {%- endif -%}
          </figure>
        </div>
      {%- endif -%}
    </div>

    <div class="sos-hero__copywrap">
      <div class="sos-hero__copy">
        {%- if s.eyebrow != blank -%}<p class="sos-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h1 class="sos-display sos-hero__title">{{ s.heading }}</h1>{%- endif -%}
        {%- if s.body != blank -%}<p class="sos-lede">{{ s.body }}</p>{%- endif -%}
        {%- if s.button_label != blank or s.button2_label != blank -%}
          <div class="sos-hero__actions">
            {%- if s.button_label != blank -%}
              <a class="sos-btn sos-btn--primary" href="{{ s.button_link | default: routes.all_products_collection_url }}">
                {{ s.button_label }}{% render 'sos-icon', name: 'arrow' %}
              </a>
            {%- endif -%}
            {%- if s.button2_label != blank -%}
              <a class="sos-btn sos-btn--ghost" href="{{ s.button2_link | default: routes.root_url }}">{{ s.button2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </section>
</div>

{% schema %}
{
  "name": "Palace hero",
  "tag": "section",
  "class": "sos-hero-section",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Sultan's Collection" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A collection worth crossing kingdoms for." },
    { "type": "textarea", "id": "body", "label": "Supporting line", "default": "Discover collectible statues, distinctive sculpts and remarkable display pieces." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },

    { "type": "header", "content": "Palace plate" },
    { "type": "text", "id": "desktop_stem", "label": "Desktop asset stem", "default": "sos-hero-desktop" },
    { "type": "text", "id": "desktop_widths", "label": "Desktop widths", "default": "900,1280,1774" },
    { "type": "text", "id": "mobile_stem", "label": "Mobile asset stem", "default": "sos-hero-mobile" },
    { "type": "text", "id": "mobile_widths", "label": "Mobile widths", "default": "640,860,1024" },
    { "type": "number", "id": "plate_width", "label": "Plate intrinsic width (px)", "default": 1774 },
    { "type": "number", "id": "plate_height", "label": "Plate intrinsic height (px)", "default": 887 },
    { "type": "text", "id": "plate_alt", "label": "Plate description", "default": "Gear 5 Luffy statue displayed on a stone pedestal in a sunlit palace gallery" },
    { "type": "text", "id": "plate_caption", "label": "Plaque caption", "default": "Gear 5 Luffy — Anikingdom x Jimei Palace — 1/6 scale" },
    {
      "type": "select", "id": "focal_point", "label": "Desktop focal point",
      "options": [
        { "value": "50% 62%", "label": "Hold the pedestal (default)" },
        { "value": "50% 50%", "label": "Centre" },
        { "value": "62% 62%", "label": "Right of centre" }
      ],
      "default": "50% 62%"
    },

    { "type": "header", "content": "Featured piece on the pedestal" },
    { "type": "text", "id": "piece_stem", "label": "Piece asset stem", "default": "" },
    { "type": "text", "id": "piece_widths", "label": "Piece widths", "default": "760,1100,1520" },
    { "type": "number", "id": "piece_width", "label": "Piece intrinsic width (px)", "default": 1600 },
    { "type": "number", "id": "piece_height", "label": "Piece intrinsic height (px)", "default": 1188 },
    { "type": "text", "id": "piece_alt", "label": "Piece description", "default": "Gear 5 Luffy resin statue by Anikingdom x Jimei Palace" },
    { "type": "text", "id": "piece_caption", "label": "Plaque caption", "default": "Gear 5 Luffy — Anikingdom x Jimei Palace — 1/6 scale" },
    { "type": "range", "id": "piece_x", "label": "Desktop — horizontal", "min": 40, "max": 85, "step": 1, "unit": "%", "default": 63 },
    { "type": "range", "id": "piece_bottom", "label": "Desktop — sits above base", "min": 5, "max": 45, "step": 1, "unit": "%", "default": 19 },
    { "type": "range", "id": "piece_w", "label": "Desktop — width", "min": 14, "max": 46, "step": 1, "unit": "%", "default": 30 },
    { "type": "range", "id": "piece_x_m", "label": "Mobile — horizontal", "min": 20, "max": 80, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "piece_bottom_m", "label": "Mobile — sits above base", "min": 2, "max": 40, "step": 1, "unit": "%", "default": 13 },
    { "type": "range", "id": "piece_w_m", "label": "Mobile — width", "min": 30, "max": 90, "step": 1, "unit": "%", "default": 62 }
  ],
  "presets": [{ "name": "Palace hero" }]
}
{% endschema %}
