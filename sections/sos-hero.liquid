{% comment %}
  Sultan of Statues — palace hero.

  v2 handoff: the photographic palace plate supplied in claude-handoff is the
  architectural setting. All previously CSS-drawn scenery (arcade, light
  shaft, arched alcove, stone plinth) has been removed — the artwork contains
  its own pedestal, and nothing is drawn over it.

  The plate is delivered as AVIF -> WebP -> JPEG, desktop and mobile chosen by
  media query so only one is fetched, eager with high priority, with intrinsic
  dimensions reserved so there is no layout shift.

  The headline, supporting line and CTA are live HTML — no UI is baked into
  the artwork.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign dw = s.desktop_widths | split: ','
  assign mw = s.mobile_widths | split: ','
-%}

<div class="sos">
  <section class="sos-hero">

    {%- if s.plate_desktop != blank or s.desktop_stem != blank -%}
      <div class="sos-hero__media">
        <picture>
          {%- if s.plate_mobile != blank -%}
            <source media="(max-width: 1000px)"
                    srcset="{{ s.plate_mobile | image_url: width: 1024 }}"
                    type="image/jpeg">
          {%- elsif s.mobile_stem != blank -%}
            <source media="(max-width: 1000px)" type="image/avif" srcset="
              {%- for w in mw -%}{{ s.mobile_stem | append: '-' | append: w | append: '.avif' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
              sizes="100vw">
            <source media="(max-width: 1000px)" type="image/webp" srcset="
              {%- for w in mw -%}{{ s.mobile_stem | append: '-' | append: w | append: '.webp' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
              sizes="100vw">
            <source media="(max-width: 1000px)"
                    srcset="{{ s.mobile_stem | append: '-' | append: mw.last | append: '.jpg' | asset_url }}">
          {%- endif -%}

          {%- if s.plate_desktop != blank -%}
            <source srcset="{{ s.plate_desktop | image_url: width: 2000 }}" type="image/jpeg">
            <img
              src="{{ s.plate_desktop | image_url: width: 2000 }}"
              alt="{{ s.plate_alt | escape }}"
              width="{{ s.plate_desktop.width }}" height="{{ s.plate_desktop.height }}"
              fetchpriority="high" decoding="async"
              style="--sos-hero-focus: {{ s.focal_point }};">
          {%- else -%}
            <source type="image/avif" srcset="
              {%- for w in dw -%}{{ s.desktop_stem | append: '-' | append: w | append: '.avif' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
              sizes="100vw">
            <source type="image/webp" srcset="
              {%- for w in dw -%}{{ s.desktop_stem | append: '-' | append: w | append: '.webp' | asset_url }} {{ w }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
              sizes="100vw">
            <img
              src="{{ s.desktop_stem | append: '-' | append: dw.last | append: '.jpg' | asset_url }}"
              alt="{{ s.plate_alt | escape }}"
              width="{{ s.plate_width }}" height="{{ s.plate_height }}"
              fetchpriority="high" decoding="async"
              style="--sos-hero-focus: {{ s.focal_point }};">
          {%- endif -%}
        </picture>
      </div>

      {%- if s.show_scrim -%}
        <div class="sos-hero__scrim" aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}

    <div class="sos-hero__copywrap">
      <div class="sos-hero__copy">
        {%- if s.eyebrow != blank -%}
          <p class="sos-eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h1 class="sos-display sos-hero__title">{{ s.heading }}</h1>
        {%- endif -%}

        {%- if s.body != blank -%}
          <p class="sos-lede">{{ s.body }}</p>
        {%- endif -%}

        {%- if s.button_label != blank or s.button2_label != blank -%}
          <div class="sos-hero__actions">
            {%- if s.button_label != blank -%}
              <a class="sos-btn sos-btn--primary" href="{{ s.button_link | default: routes.all_products_collection_url }}">
                {{ s.button_label }}
                {% render 'sos-icon', name: 'arrow' %}
              </a>
            {%- endif -%}
            {%- if s.button2_label != blank -%}
              <a class="sos-btn sos-btn--ghost" href="{{ s.button2_link | default: routes.root_url }}">
                {{ s.button2_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </section>
</div>

{% schema %}
{
  "name": "Palace hero",
  "tag": "section",
  "class": "sos-hero-section",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Sultan's Collection" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A collection worth crossing kingdoms for." },
    { "type": "textarea", "id": "body", "label": "Supporting line", "default": "Rare collectible statues, acquired from private collections across the UK." },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },

    { "type": "header", "content": "Palace plate" },
    { "type": "paragraph", "content": "By default the theme serves the supplied handoff plates as AVIF, WebP and JPEG derivatives. Only use the pickers below to override with a newer plate." },
    { "type": "text", "id": "desktop_stem", "label": "Desktop asset stem", "default": "sos-hero-desktop" },
    { "type": "text", "id": "desktop_widths", "label": "Desktop widths", "default": "900,1280,1774" },
    { "type": "text", "id": "mobile_stem", "label": "Mobile asset stem", "default": "sos-hero-mobile" },
    { "type": "text", "id": "mobile_widths", "label": "Mobile widths", "default": "640,860,1024" },
    { "type": "range", "id": "plate_width", "label": "Desktop plate intrinsic width", "min": 800, "max": 3000, "step": 2, "unit": "px", "default": 1774 },
    { "type": "range", "id": "plate_height", "label": "Desktop plate intrinsic height", "min": 400, "max": 2000, "step": 1, "unit": "px", "default": 887 },
    { "type": "image_picker", "id": "plate_desktop", "label": "Override — desktop plate" },
    { "type": "image_picker", "id": "plate_mobile", "label": "Override — mobile plate" },
    { "type": "text", "id": "plate_alt", "label": "Plate description", "default": "Sunlit ivory limestone palace gallery with an empty stone display pedestal" },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Desktop focal point",
      "options": [
        { "value": "50% 62%", "label": "Hold the pedestal (default)" },
        { "value": "50% 50%", "label": "Centre" },
        { "value": "62% 62%", "label": "Right of centre" },
        { "value": "50% 100%", "label": "Floor" }
      ],
      "default": "50% 62%"
    },
    { "type": "checkbox", "id": "show_scrim", "label": "Scrim behind the editorial column", "default": true }
  ],
  "presets": [{ "name": "Palace hero" }]
}
{% endschema %}
