{% comment %}
  Sultan of Statues — Modern Palace footer.

  Bespoke because Savor's footer draws its columns from the store-level
  "footer" and "main-menu" link lists, which still carry the card-shop and
  consignment links when this section was written. This
  section owns its links, its description measure and its copyright line, so
  staging is correct while the shared menus are still the old ones.

  The description sits in its own column with a max measure in ch, so it
  wraps on its own words at every width instead of being squeezed into a
  narrow track by a flex row.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign nav_items = section.blocks | where: 'type', 'nav_item'
  assign year = 'now' | date: '%Y'
  assign biz = s.business_name | default: 'Sultan of Statues'
-%}

<div class="sos">
  <footer class="sos-footer" role="contentinfo">
    <div class="sos-wrap">
      <ul class="sos-store-benefits" aria-label="Shopping with Sultan of Statues">
        <li><a href="/collections/one-piece-statues">{% render 'sos-icon', name: 'gem' %}<span><strong>UK stock</strong><small>Pre-owned resin statues</small></span></a></li>
        <li><a href="/pages/delivery-and-guarantee#delivery">{% render 'sos-icon', name: 'parcel' %}<span><strong>Personal delivery</strong><small>See your price by postcode</small></span></a></li>
        <li><a href="/pages/delivery-and-guarantee#guarantee">{% render 'sos-icon', name: 'shield' %}<span><strong>Handover guarantee</strong><small>Full refund if not as described</small></span></a></li>
        <li><a href="/pages/delivery-and-guarantee#collection">{% render 'sos-icon', name: 'layers' %}<span><strong>Free London collection</strong><small>Arrange a time with us</small></span></a></li>
      </ul>

      <div class="sos-footer__reviews"><a class="sos-review-link" href="https://uk.trustpilot.com/review/sultanofstatues.com"><span class="sos-review-link__mark" aria-hidden="true">&#9733;</span><span>See us on <strong>Trustpilot</strong></span></a></div>
      <div class="sos-footer__grid">

        <div class="sos-footer__brand">
          <span class="sos-logo__word sos-footer__word">
            {{ s.logo_lead }} <em>{{ s.logo_join }}</em> {{ s.logo_tail }}
          </span>
          {%- if s.description != blank -%}
            <p class="sos-footer__desc">{{ s.description }}</p>
          {%- endif -%}
          {%- if s.location_note != blank -%}
            <p class="sos-footer__note">{{ s.location_note }}</p>
          {%- endif -%}
        </div>

        {%- if nav_items.size > 0 -%}
          <nav class="sos-footer__col" aria-label="Footer">
            <h2 class="sos-footer__h">{{ s.nav_heading }}</h2>
            <ul class="sos-footer__list">
              {%- for block in nav_items -%}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label }}</a>
                </li>
              {%- endfor -%}
              <li><a href="/blogs/news/the-statue-that-looked-perfect">How to Buy Resin Statues</a></li>
            </ul>
          </nav>
        {%- endif -%}

        <div class="sos-footer__col">
          <h2 class="sos-footer__h">{{ s.contact_heading }}</h2>
          <ul class="sos-footer__list">
            {%- if s.contact_email != blank -%}
              <li><a href="mailto:{{ s.contact_email }}">{{ s.contact_email }}</a></li>
            {%- endif -%}
            {%- assign whatsapp_prefix = s.whatsapp_url | slice: 0, 14 -%}
            {%- if whatsapp_prefix == 'https://wa.me/' -%}
              <li><a href="{{ s.whatsapp_url | escape }}">Chat on WhatsApp</a></li>
            {%- endif -%}
            <li><a href="{{ s.contact_link | default: '/pages/contact' }}">{{ s.contact_link_label }}</a></li>
            <li><a href="{{ s.sell_link | default: '/pages/sell-to-us' }}">{{ s.sell_link_label }}</a></li>
          </ul>
        </div>

      </div>

      {%- capture social_links -%}
        <a class="sos-btn sos-social__primary" href="https://www.youtube.com/@SultanOfStatues" target="_blank" rel="noopener">YouTube</a>
        <a href="https://www.instagram.com/sultanofstatues/?hl=en" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.tiktok.com/@sultanofstatues" target="_blank" rel="noopener">TikTok</a>
        <a href="https://uk.pinterest.com/sultan_of_statues/" target="_blank" rel="noopener">Pinterest</a>
        <a href="https://www.facebook.com/profile.php?id=61595835342958" target="_blank" rel="noopener">Facebook</a>
      {%- endcapture -%}
      <div class="sos-footer__social">
        <img class="sos-footer__social-emblem" src="{{ 'sos-emblem@3x.png' | asset_url }}" width="245" height="216" alt="" loading="lazy" decoding="async">
        <div class="sos-footer__social-copy">
          <h2 class="sos-footer__h">Follow Sultan of Statues</h2>
          <div class="sos-social__links">{{ social_links }}</div>
        </div>
      </div>
      {%- unless request.page_type == 'cart' or request.design_mode -%}
        <dialog class="sos-social-dialog" data-sos-social-exit aria-labelledby="sos-social-title-{{ section.id }}">
          <button type="button" class="sos-social-dialog__close" data-sos-social-close aria-label="Close" autofocus>{% render 'sos-icon', name: 'close' %}</button>
          <div class="sos-social-dialog__layout">
            <img class="sos-social-dialog__emblem" src="{{ 'sos-emblem@3x.png' | asset_url }}" width="245" height="216" alt="" loading="lazy" decoding="async">
            <div class="sos-social-dialog__copy">
              <h2 id="sos-social-title-{{ section.id }}">See the statues up close</h2>
              <p>Follow Sultan of Statues. Start with YouTube or find us on your favourite channel.</p>
              <div class="sos-social__links">{{ social_links }}</div>
            </div>
          </div>
        </dialog>
      {%- endunless -%}

      <div class="sos-footer__base">
        <p class="sos-footer__copy">&copy; {{ year }} {{ biz }}{% if s.legal_note != blank %}. {{ s.legal_note }}{% endif %}</p>

        {%- if shop.policies.size > 0 or s.show_policies -%}
          <ul class="sos-footer__policies">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Palace footer",
  "tag": "section",
  "class": "sos-footer-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "logo_lead", "label": "Wordmark — first word", "default": "Sultan" },
    { "type": "text", "id": "logo_join", "label": "Wordmark — joining word", "default": "of" },
    { "type": "text", "id": "logo_tail", "label": "Wordmark — last word", "default": "Statues" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "We buy and sell collectible statues in the United Kingdom — resin and polystone display pieces from specialist studios." },
    { "type": "text", "id": "location_note", "label": "Location note", "default": "United Kingdom" },

    { "type": "header", "content": "Links" },
    { "type": "text", "id": "nav_heading", "label": "Links heading", "default": "Browse" },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Get in touch" },
    { "type": "text", "id": "contact_email", "label": "Contact email" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link (https://wa.me/...)" },
    { "type": "text", "id": "contact_link_label", "label": "Contact link label", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "text", "id": "sell_link_label", "label": "Sell link label", "default": "Sell your statues" },
    { "type": "url", "id": "sell_link", "label": "Sell link" },

    { "type": "header", "content": "Base line" },
    { "type": "text", "id": "business_name", "label": "Business name for copyright", "default": "Sultan of Statues" },
    { "type": "paragraph", "content": "This is the theme's own copyright name. Shopify's stock copyright prints the store name from Settings, which is still the old card-shop name until that is changed." },
    { "type": "text", "id": "legal_note", "label": "Legal note" },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Footer link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The Collection" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
