{% comment %}
  Sultan of Statues — product page.

  Real Shopify product data throughout: media gallery, price, availability,
  stock, and a native product form posting to /cart/add. Nothing about price
  or availability is typed into the theme.

  Single-variant pieces (one statue, one of it) render without a variant
  picker; if a piece ever has options, the picker appears automatically.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign sold_out = false
  unless p.available
    assign sold_out = true
  endunless
-%}

<div class="sos">
  <section class="sos-product">
    <div class="sos-wrap">

      {%- liquid
        comment
          The piece's own collection when it has one, so the crumb and the
          BreadcrumbList agree and the listing links back to the page we
          want ranking. collection is set when the product was reached
          through a collection; otherwise fall back to the setting.
        endcomment
        assign crumb_url = routes.all_products_collection_url
        assign crumb_label = s.back_label

        comment
          The configured fallback is only used once that collection actually
          exists and has stock. Pointing at it unconditionally put a 404 on
          every product page the moment this shipped, because the One Piece
          collection has not been created yet.
        endcomment
        if s.collection_handle != blank
          assign crumb_target = collections[s.collection_handle]
          if crumb_target != blank and crumb_target.products_count > 0
            assign crumb_url = crumb_target.url
            assign crumb_label = crumb_target.title
          endif
        endif

        if collection != blank and collection.handle != blank and collection.handle != 'all'
          assign crumb_url = collection.url
          assign crumb_label = collection.title
        endif
      -%}

      <nav class="sos-crumb" aria-label="Breadcrumb">
        <a href="{{ crumb_url }}">{{ crumb_label }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ p.title }}</span>
      </nav>

      <div class="sos-product__grid">

        {%- comment -%}
          Compact gallery: one viewport, thumbnails under it, tap or click to
          enlarge. It used to render every shot stacked, so the nine-photograph
          piece pushed its own name 2,184px down a phone and the buy button to
          2.7 screens. Shots are all in the DOM — good for crawlers and for a
          no-JS visitor, who simply gets the stack back — but only the active
          one is shown once the script runs.

          Aspect ratios differ between pieces, so the frame is fixed and the
          image is contained inside it. Nothing is cropped or stretched.
        {%- endcomment -%}
        <div class="sos-product__media" data-sos-gallery>
          {%- if p.media.size > 0 -%}
            <div class="sos-product__stage">
              {%- for media in p.media -%}
                {%- liquid
                  assign loading = 'lazy'
                  if forloop.first
                    assign loading = 'eager'
                  endif

                  comment
                    Alt text set on the media in Shopify always wins. The
                    fallback names the piece, its maker and which shot it is,
                    so nine photographs no longer share one alt.
                  endcomment
                  assign shot_alt = media.alt
                  if shot_alt == blank
                    assign shot_alt = p.title
                    if p.vendor != blank
                      assign shot_alt = shot_alt | append: ' resin statue by ' | append: p.vendor
                    endif
                    if forloop.first
                      assign shot_alt = shot_alt | append: ', full view'
                    else
                      assign shot_alt = shot_alt | append: ', detail ' | append: forloop.index0
                    endif
                  endif
                -%}
                <figure class="sos-product__shot{% if forloop.first %} is-active{% endif %}"
                        data-sos-shot="{{ forloop.index0 }}">
                  {{ media
                     | image_url: width: 1600
                     | image_tag:
                       widths: '500, 760, 1100, 1600',
                       sizes: '(max-width: 1000px) 94vw, 52vw',
                       loading: loading,
                       alt: shot_alt }}
                </figure>
              {%- endfor -%}

              {%- if p.media.size > 1 -%}
                <button type="button" class="sos-gal__nav sos-gal__nav--prev" data-sos-gal-prev aria-label="Previous photograph">
                  {% render 'sos-icon', name: 'caret' %}
                </button>
                <button type="button" class="sos-gal__nav sos-gal__nav--next" data-sos-gal-next aria-label="Next photograph">
                  {% render 'sos-icon', name: 'caret' %}
                </button>
              {%- endif -%}

              <button type="button" class="sos-gal__zoom" data-sos-gal-zoom aria-label="Enlarge photograph">
                <span aria-hidden="true">&plus;</span>
              </button>
              <p class="sos-gal__count" data-sos-gal-count aria-live="polite">1 / {{ p.media.size }}</p>
            </div>

            {%- if p.media.size > 1 -%}
              <ul class="sos-gal__thumbs" data-sos-gal-thumbs>
                {%- for media in p.media -%}
                  <li>
                    <button type="button"
                            class="sos-gal__thumb{% if forloop.first %} is-active{% endif %}"
                            data-sos-gal-go="{{ forloop.index0 }}"
                            aria-label="Show photograph {{ forloop.index }} of {{ p.media.size }}">
                      {{ media | image_url: width: 220 | image_tag: widths: '110, 220', alt: '', loading: 'lazy' }}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- else -%}
            <div class="sos-product__nomedia">
              <p>Photographs of this piece are being prepared.</p>
            </div>
          {%- endif -%}
        </div>

        <div class="sos-product__panel">
          <div class="sos-product__sticky">

            {%- if p.vendor != blank -%}
              <p class="sos-eyebrow">{{ p.vendor }}</p>
            {%- endif -%}

            <h1 class="sos-display sos-product__title">{{ p.title }}</h1>

            <div class="sos-product__priceline">
              <span class="sos-product__price">{{ v.price | money }}</span>
              {%- if v.compare_at_price > v.price -%}
                <s class="sos-product__was">{{ v.compare_at_price | money }}</s>
              {%- endif -%}
            </div>

            {%- comment -%} Availability, straight from Shopify inventory. {%- endcomment -%}
            <p class="sos-product__avail{% if sold_out %} is-sold{% endif %}">
              {%- if sold_out -%}
                <span class="sos-dot" aria-hidden="true"></span>Sold
              {%- elsif v.inventory_management == 'shopify' and v.inventory_quantity > 0 -%}
                <span class="sos-dot" aria-hidden="true"></span>
                In stock{% if v.inventory_quantity == 1 %} — one only{% else %} — {{ v.inventory_quantity }} available{% endif %}
              {%- else -%}
                <span class="sos-dot" aria-hidden="true"></span>In stock
              {%- endif -%}
            </p>

            {%- if sold_out -%}
              <div class="sos-product__soldbox">
                <p>This piece has been sold.</p>
                <a class="sos-btn sos-btn--ghost" href="{{ routes.all_products_collection_url }}">
                  See what else is in the collection{% render 'sos-icon', name: 'arrow' %}
                </a>
                <a class="sos-textlink" href="{{ s.enquiry_page | default: '/pages/contact' }}?piece={{ p.title | url_param_escape }}">
                  Ask us to look out for one{% render 'sos-icon', name: 'arrow' %}
                </a>
              </div>
            {%- else -%}
              {%- comment -%}
                Choices before the button. Add to bag used to sit above the
                configurator with the running total 765px below it on a phone,
                so a shopper was asked to commit before picking collection or
                delivery and never saw what they would actually pay. The panel
                now comes first and the button last, directly under the total
                it refers to.
              {%- endcomment -%}
              {% render 'sos-cost-panel', product: p, enquiry_page: s.enquiry_page %}
              {%- form 'product', p, id: 'sos-add', class: 'sos-product__form' -%}
                {%- unless p.has_only_default_variant -%}
                  <div class="sos-product__variants">
                    <label class="sos-field__label" for="sos-variant">Option</label>
                    <select id="sos-variant" name="id" class="sos-select">
                      {%- for variant in p.variants -%}
                        <option value="{{ variant.id }}"
                          {% if variant == v %}selected{% endif %}
                          {% unless variant.available %}disabled{% endunless %}>
                          {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (sold){% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                {%- endunless -%}

                <input type="hidden" name="quantity" value="1">

                <button type="submit" name="add" class="sos-btn sos-btn--primary sos-product__add">
                  {{ s.add_label }}{% render 'sos-icon', name: 'arrow' %}
                </button>
              {%- endform -%}

              <a class="sos-textlink sos-product__ask" href="{{ s.enquiry_page | default: '/pages/contact' }}?piece={{ p.title | url_param_escape }}">
                {{ s.ask_label }}{% render 'sos-icon', name: 'arrow' %}
              </a>

              <div class="sos-product__guarantee">
                {% render 'sos-guarantee', variant: 'inline' %}
              </div>
            {%- endif -%}

            {%- if p.description != blank -%}
              <div class="sos-product__desc sos-prose__body">{{ p.description }}</div>
            {%- endif -%}

            {%- liquid
              assign mf = p.metafields.sos
              assign has_dims = false
              if mf.height != blank or mf.width != blank or mf.depth != blank or mf.base != blank
                assign has_dims = true
              endif
            -%}

            {%- comment -%}
              Measured pieces show their numbers. Unmeasured pieces say so and
              offer a route to an answer — silence would leave someone spending
              four figures with no idea whether it clears their shelf, and an
              invented number would be worse than silence.
            {%- endcomment -%}
            {%- unless has_dims -%}
              <section class="sos-spec">
                <h2 class="sos-spec__h">Will it fit?</h2>
                <p class="sos-spec__p">
                  We haven't published measurements for this piece yet.
                  <a href="{{ s.enquiry_page | default: '/pages/contact' }}?piece={{ p.title | url_param_escape }}&amp;about=dimensions">Ask us for its dimensions</a>
                  and we'll measure it and send them before you buy.
                </p>
              </section>
            {%- endunless -%}

            {%- if has_dims -%}
              <section class="sos-spec">
                <h2 class="sos-spec__h">Will it fit?</h2>
                <dl class="sos-spec__list">
                  {%- if mf.height != blank -%}<div><dt>Assembled height</dt><dd>{{ mf.height }}</dd></div>{%- endif -%}
                  {%- if mf.width != blank -%}<div><dt>Width</dt><dd>{{ mf.width }}</dd></div>{%- endif -%}
                  {%- if mf.depth != blank -%}<div><dt>Depth</dt><dd>{{ mf.depth }}</dd></div>{%- endif -%}
                  {%- if mf.base != blank -%}<div><dt>Base footprint</dt><dd>{{ mf.base }}</dd></div>{%- endif -%}
                  {%- if mf.overhang != blank -%}<div><dt>Overhang</dt><dd>{{ mf.overhang }}</dd></div>{%- endif -%}
                  {%- if mf.boxed != blank -%}<div><dt>Packed box</dt><dd>{{ mf.boxed }}</dd></div>{%- endif -%}
                  {%- if mf.weight != blank -%}<div><dt>Packed weight</dt><dd>{{ mf.weight }}</dd></div>{%- endif -%}
                </dl>
                {%- if mf.dims_note != blank -%}
                  <p class="sos-spec__note">{{ mf.dims_note }}</p>
                {%- endif -%}
              </section>
            {%- endif -%}

            {%- liquid
              comment
                Per-piece metafield wins. The section default is the line that
                is true of every piece in the collection; anything beyond that
                — spare parts, LED units, certificates — must be confirmed per
                statue and set on the product, never assumed here.
              endcomment
              assign included = mf.included | default: s.included_default
            -%}
            {%- if included != blank -%}
              <section class="sos-spec">
                <h2 class="sos-spec__h">What's included</h2>
                <div class="sos-prose__body sos-spec__body">{{ included }}</div>
              </section>
            {%- endif -%}

            <section class="sos-spec">
              <h2 class="sos-spec__h">Questions, damage or missing parts</h2>
              <p class="sos-spec__p">
                One contact for everything: {{ s.support_label | default: 'email us' }} at
                <a href="mailto:{{ s.support_email | default: 'sultan@sultanofstatues.com' }}">{{ s.support_email | default: 'sultan@sultanofstatues.com' }}</a>.
                Tell us your order number and we'll sort it.
              </p>
            </section>

            {%- if s.note != blank -%}
              <p class="sos-product__note">{{ s.note }}</p>
            {%- endif -%}

          </div>
        </div>

      </div>
    </div>
  </section>
</div>

{%- comment -%}
  Product and Offer structured data.

  Nothing on the storefront emitted any before this: the Savor sections that
  carry it are not used by these pages, so Google had no price, availability
  or condition for any of the six pieces.

  Every value is read from the product, so the markup cannot drift from what
  the page shows. Condition is UsedCondition because the whole catalogue is
  pre-owned. Price is rendered unformatted in GBP, which is what
  schema.org wants, and matches the figure in the price line above.

  Only emitted for a real, purchasable piece — never for the assembly
  add-on, which is a service and not a product anyone should land on.
{%- endcomment -%}
{%- if p.handle != 'in-home-assembly' -%}
  {%- liquid
    assign ld_availability = 'https://schema.org/InStock'
    unless p.available
      assign ld_availability = 'https://schema.org/OutOfStock'
    endunless
    assign ld_desc = p.description | replace: '</', ' </' | strip_html | strip_newlines | replace: '  ', ' ' | strip | truncate: 480
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ p.title | json }},
      "url": {{ request.origin | append: p.url | json }},
      {% if ld_desc != blank %}"description": {{ ld_desc | json }},{% endif %}
      {% if p.featured_media %}"image": [
        {%- for media in p.media limit: 6 -%}
          {{ media | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],{% endif %}
      {% if p.vendor != blank %}"brand": { "@type": "Brand", "name": {{ p.vendor | json }} },{% endif %}
      {% if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
      "itemCondition": "https://schema.org/UsedCondition",
      "offers": {
        "@type": "Offer",
        "url": {{ request.origin | append: p.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ v.price | divided_by: 100.0 | json }},
        "availability": {{ ld_availability | json }},
        "itemCondition": "https://schema.org/UsedCondition",
        "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ crumb_label | json }}, "item": {{ request.origin | append: crumb_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ p.title | json }} }
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Palace product",
  "tag": "section",
  "class": "sos-product-section",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Breadcrumb label", "default": "The Collection" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to bag" },
    { "type": "text", "id": "ask_label", "label": "Enquiry link", "default": "Ask a question about this piece" },
    { "type": "url", "id": "enquiry_page", "label": "Enquiry page" },
    { "type": "text", "id": "collection_handle", "label": "Collection handle the breadcrumb falls back to" },
    { "type": "paragraph", "content": "A handle such as one-piece-statues. Used for a direct visit from search, and only once that collection exists and has products — otherwise the breadcrumb goes to the full catalogue. When a shopper arrives through a collection, that collection wins." },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "sultan@sultanofstatues.com" },
    { "type": "richtext", "id": "included_default", "label": "What's included (fallback)", "default": "<p>The statue and its original box and inner packaging. Anything else specific to this piece is listed on the product above.</p>" },
    { "type": "paragraph", "content": "Per-piece contents and dimensions come from product metafields (sos.included, sos.height, sos.width, sos.depth, sos.base, sos.overhang, sos.boxed, sos.weight). Will it fit? stays hidden until a piece has been measured." },
    { "type": "paragraph", "content": "Where the enquiry links point. Left blank it uses /pages/contact." },
    { "type": "textarea", "id": "note", "label": "Panel note" }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
