{% comment %}
  Sultan of Statues — webcomic episode.

  A reusable scene runner for The Collector's Journey. One block per scene,
  in reading order. The artwork is an image; the dialogue is real HTML text
  sitting in speech bubbles over it, never baked into the picture — so it is
  selectable, translatable, searchable and readable by a screen reader.

  Bubble placement is per bubble. On desktop a bubble can sit over any of
  the four corners of the artwork; "below" drops it into a dialogue strip
  under the scene for panels where an overlay would cover something that
  matters. Under 760px every bubble moves to the strip regardless, because
  a bubble over a phone-width panel covers a third of the art.

  The fiction notice is not decoration. "Photographs of the actual piece"
  is the shop's core claim, and drawn statues sitting a scroll away from
  real listings could undercut it if the difference were left implied.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign scenes = section.blocks | where: 'type', 'scene'
-%}

<div class="sos">
  <article class="sos-comic">
    <div class="sos-wrap sos-wrap--narrow">

      {%- if s.eyebrow != blank or s.heading != blank -%}
        <header class="sos-comic__head">
          {%- if s.eyebrow != blank -%}<p class="sos-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h1 class="sos-display sos-comic__title">{{ s.heading }}</h1>{%- endif -%}
          {%- if s.standfirst != blank -%}<div class="sos-lede sos-comic__standfirst">{{ s.standfirst }}</div>{%- endif -%}
        </header>
      {%- endif -%}

      {%- if s.intro != blank -%}
        <div class="sos-prose__body sos-comic__intro">{{ s.intro }}</div>
      {%- endif -%}

      {%- if s.fiction_note != blank -%}
        <aside class="sos-comic__notice" role="note">
          {% render 'sos-icon', name: 'shield', size: 18 %}
          <p>{{ s.fiction_note }}</p>
        </aside>
      {%- endif -%}

      {%- if scenes.size > 0 -%}
        <div class="sos-comic__strip">
          {%- for block in scenes -%}
            {%- liquid
              assign b = block.settings
              assign n = forloop.index
              assign has_overlay = false
              for i in (1..3)
                assign tkey = 'bubble' | append: i | append: '_text'
                assign pkey = 'bubble' | append: i | append: '_pos'
                assign txt = b[tkey]
                assign pos = b[pkey]
                if txt != blank and pos != 'below'
                  assign has_overlay = true
                endif
              endfor
            -%}
            <section
              class="sos-comic__scene{% if has_overlay %} has-overlay{% endif %}"
              aria-label="Scene {{ n }}{% if b.scene_label != blank %}: {{ b.scene_label | escape }}{% endif %}"
              {{ block.shopify_attributes }}
            >
              <figure class="sos-comic__figure">
                <div class="sos-comic__art">
                  {%- if b.image != blank -%}
                    {{ b.image
                       | image_url: width: 1600
                       | image_tag:
                         class: 'sos-comic__img',
                         widths: '480, 760, 1000, 1280, 1600',
                         sizes: '(max-width: 760px) 100vw, (max-width: 1100px) 90vw, 860px',
                         loading: 'lazy',
                         alt: b.alt }}
                  {%- elsif b.image_asset != blank -%}
                    {%- comment -%}
                      Theme-asset fallback, the same dual source sos-collection
                      uses. Shopify Files is the better long-term home for
                      episode art, but an asset works today and swapping to a
                      Files image later is one picker click per scene.
                    {%- endcomment -%}
                    <img
                      class="sos-comic__img"
                      src="{{ b.image_asset | asset_url }}"
                      alt="{{ b.alt | escape }}"
                      width="1122"
                      height="1402"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      decoding="async"
                    >
                  {%- else -%}
                    <div class="sos-comic__placeholder" aria-hidden="true">Scene {{ n }} artwork</div>
                  {%- endif -%}

                  {%- comment -%}
                    Overlay bubbles. Rendered inside the art frame on desktop
                    and re-homed below it on narrow screens by CSS alone, so
                    the markup order stays the reading order either way.
                  {%- endcomment -%}
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign tkey = 'bubble' | append: i | append: '_text'
                      assign skey = 'bubble' | append: i | append: '_speaker'
                      assign pkey = 'bubble' | append: i | append: '_pos'
                      assign tail = 'bubble' | append: i | append: '_tail'
                      assign txt = b[tkey]
                      assign pos = b[pkey] | default: 'below'
                    -%}
                    {%- if txt != blank and pos != 'below' -%}
                      <div class="sos-bubble sos-bubble--{{ pos }}{% if b[tail] %} sos-bubble--tail{% endif %}">
                        {%- if b[skey] != blank -%}
                          <span class="sos-bubble__who">{{ b[skey] }}</span>
                        {%- endif -%}
                        <p class="sos-bubble__say">{{ txt }}</p>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- comment -%} The strip beneath: "below" bubbles, plus every bubble on mobile. {%- endcomment -%}
                <figcaption class="sos-comic__below">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign tkey = 'bubble' | append: i | append: '_text'
                      assign skey = 'bubble' | append: i | append: '_speaker'
                      assign pkey = 'bubble' | append: i | append: '_pos'
                      assign txt = b[tkey]
                      assign pos = b[pkey] | default: 'below'
                    -%}
                    {%- if txt != blank -%}
                      <div class="sos-bubble sos-bubble--strip{% if pos != 'below' %} is-echo{% endif %}">
                        {%- if b[skey] != blank -%}
                          <span class="sos-bubble__who">{{ b[skey] }}</span>
                        {%- endif -%}
                        <p class="sos-bubble__say">{{ txt }}</p>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if b.narration != blank -%}
                    <p class="sos-comic__narration">{{ b.narration }}</p>
                  {%- endif -%}
                </figcaption>
              </figure>
            </section>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.outro != blank -%}
        <div class="sos-prose__body sos-comic__outro">{{ s.outro }}</div>
      {%- endif -%}

    </div>
  </article>
</div>

{%- comment -%}
  Article structured data. Emitted only on an article template, and only
  from this section, so it cannot double up: I checked the stock article
  template and main-blog-post, and neither emits Article markup today.

  headline is the H1 the page actually shows, not the Shopify article
  title, because Google asks that structured data match visible content.
  No author node: the series has no named byline, and inventing one would
  be a claim about a person.
{%- endcomment -%}
{%- if request.page_type == 'article' and article != blank -%}
  {%- liquid
    comment
      Google asks for a wide, large image here. The scenes are portrait, so
      an episode can name a landscape card instead; the first scene is the
      fallback when it does not.
    endcomment
    assign lead = ''
    if s.share_asset != blank
      assign lead = s.share_asset | asset_url
    endif
    for b in section.blocks
      if b.type == 'scene' and lead == ''
        if b.settings.image != blank
          assign lead = b.settings.image | image_url: width: 1600 | prepend: 'https:'
        elsif b.settings.image_asset != blank
          assign lead = b.settings.image_asset | asset_url
        endif
      endif
    endfor
    assign head = s.heading | default: article.title
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ head | json }},
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ request.origin | append: article.url | json }}
      },
      "url": {{ request.origin | append: article.url | json }},
      {%- if lead != blank %}
      "image": {{ lead | json }},
      {%- endif %}
      {%- comment -%}
        A hidden or scheduled article has no published_at, which would emit
        an empty datePublished and invalidate the node. Omit both dates
        until Shopify sets one.
      {%- endcomment -%}
      {%- if article.published_at != blank %}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- endif %}
      "publisher": {
        "@type": "Organization",
        "name": {{ settings.sos_site_name | default: 'Sultan of Statues' | json }}
      },
      "isAccessibleForFree": true
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sos-comic { padding: clamp(2rem, 6vw, 4.5rem) 0; }
  .sos-wrap--narrow { max-width: 62rem; margin-inline: auto; }

  .sos-comic__head { text-align: center; margin-bottom: 1.75rem; }
  .sos-comic__title { margin: 0.4rem 0 0.8rem; }
  .sos-comic__standfirst { max-width: 46ch; margin-inline: auto; }
  .sos-comic__intro, .sos-comic__outro { max-width: 60ch; margin-inline: auto; }
  .sos-comic__outro { margin-top: clamp(2rem, 5vw, 3.25rem); }

  .sos-comic__notice {
    display: flex; gap: 0.7rem; align-items: flex-start;
    max-width: 60ch; margin: 1.5rem auto 0;
    padding: 0.85rem 1.1rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 0.6rem;
    background: color-mix(in srgb, currentColor 4%, transparent);
    font-size: 0.9rem; line-height: 1.5;
  }
  .sos-comic__notice p { margin: 0; }

  .sos-comic__strip { margin-top: clamp(2rem, 5vw, 3rem); }
  .sos-comic__scene + .sos-comic__scene { margin-top: clamp(2.25rem, 6vw, 4rem); }
  .sos-comic__figure { margin: 0; }

  .sos-comic__art {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #11100f;
  }
  .sos-comic__img { display: block; width: 100%; height: auto; }
  .sos-comic__placeholder {
    aspect-ratio: 4 / 5; display: grid; place-items: center;
    color: #cbb9a3; font-size: 0.9rem;
  }

  /* Bubbles --------------------------------------------------------- */
  .sos-bubble {
    --ink: #15100b;
    --paper: #fffdf9;
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border: 2.5px solid var(--ink);
    /* Uneven radii read as drawn rather than as a UI card. */
    border-radius: 1.6rem 1.6rem 1.7rem 1.5rem / 1.5rem 1.7rem 1.5rem 1.6rem;
    padding: 0.55rem 0.95rem 0.6rem;
    box-shadow: 2px 3px 0 rgba(21, 16, 11, 0.9);
  }
  .sos-bubble__who {
    display: block;
    font-size: 0.62rem; font-weight: 800;
    letter-spacing: 0.12em; text-transform: uppercase;
    opacity: 0.55; margin-bottom: 0.05rem;
  }
  .sos-bubble__say {
    margin: 0;
    font-size: 1rem; line-height: 1.35;
    text-wrap: pretty; hyphens: none;
  }

  /* Overlay bubbles are desktop-only; the strip carries mobile. */
  .sos-comic__art > .sos-bubble { display: none; }

  /* --- Mobile strip: compact, alternating, tied to the panel above --- */
  .sos-comic__below {
    margin-top: 0.55rem;
    display: flex; flex-direction: column;
    gap: 0.4rem;
  }
  .sos-bubble--strip {
    max-width: 86%;
    align-self: flex-start;
    padding: 0.45rem 0.85rem 0.5rem;
  }
  .sos-bubble--strip:nth-of-type(even) { align-self: flex-end; }
  .sos-bubble--strip .sos-bubble__say { font-size: 0.95rem; }

  /* First bubble points back up at the artwork it belongs to. */
  .sos-bubble--strip:first-of-type::after,
  .sos-bubble--strip:first-of-type::before {
    content: ""; position: absolute; width: 0; height: 0;
    border: 10px solid transparent;
  }
  .sos-bubble--strip:first-of-type::after {
    border-bottom-color: #15100b; top: -20px; left: 1.6rem;
  }
  .sos-bubble--strip:first-of-type::before {
    border-bottom-color: #fffdf9; top: -15px; left: 1.6rem; z-index: 1;
  }

  .sos-comic__narration {
    margin: 0.5rem 0 0; font-style: italic; opacity: 0.72;
    font-size: 0.88rem; line-height: 1.45; text-align: center;
  }

  @media (min-width: 761px) {
    .sos-comic__art > .sos-bubble {
      display: block;
      position: absolute;
      max-width: min(40%, 22rem);
      padding: 0.65rem 1.05rem 0.7rem;
      z-index: 2;
    }
    .sos-comic__art > .sos-bubble .sos-bubble__say { font-size: 1.04rem; line-height: 1.4; }
    .sos-comic__art > .sos-bubble .sos-bubble__who { font-size: 0.65rem; }

    .sos-bubble--top-left     { top: 3.5%;    left: 3.5%; }
    .sos-bubble--top-right    { top: 3.5%;    right: 3.5%; }
    .sos-bubble--bottom-left  { bottom: 4.5%; left: 3.5%; }
    .sos-bubble--bottom-right { bottom: 4.5%; right: 3.5%; }

    /* Tails hang from top-anchored bubbles and rise from bottom-anchored ones,
       so each one points back into the panel rather than off the edge. */
    .sos-bubble--tail::after, .sos-bubble--tail::before {
      content: ""; position: absolute; width: 0; height: 0;
      border: 12px solid transparent;
    }
    .sos-bubble--top-left.sos-bubble--tail::after,
    .sos-bubble--top-right.sos-bubble--tail::after {
      border-top-color: #15100b; bottom: -24px;
    }
    .sos-bubble--top-left.sos-bubble--tail::before,
    .sos-bubble--top-right.sos-bubble--tail::before {
      border-top-color: #fffdf9; bottom: -18px; z-index: 1;
    }
    .sos-bubble--bottom-left.sos-bubble--tail::after,
    .sos-bubble--bottom-right.sos-bubble--tail::after {
      border-bottom-color: #15100b; top: -24px;
    }
    .sos-bubble--bottom-left.sos-bubble--tail::before,
    .sos-bubble--bottom-right.sos-bubble--tail::before {
      border-bottom-color: #fffdf9; top: -18px; z-index: 1;
    }
    .sos-bubble--top-left.sos-bubble--tail::after,
    .sos-bubble--bottom-left.sos-bubble--tail::after { left: 2.1rem; }
    .sos-bubble--top-left.sos-bubble--tail::before,
    .sos-bubble--bottom-left.sos-bubble--tail::before { left: 2.2rem; }
    .sos-bubble--top-right.sos-bubble--tail::after,
    .sos-bubble--bottom-right.sos-bubble--tail::after { right: 2.1rem; }
    .sos-bubble--top-right.sos-bubble--tail::before,
    .sos-bubble--bottom-right.sos-bubble--tail::before { right: 2.2rem; }

    /* A line already shown over the art is not repeated underneath. */
    .sos-bubble--strip.is-echo { display: none; }

    .sos-comic__below { gap: 0.5rem; margin-top: 0.7rem; }
    .sos-bubble--strip { max-width: 72%; }
    .sos-bubble--strip .sos-bubble__say { font-size: 1.02rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sos-comic__scene { scroll-margin-top: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Webcomic episode",
  "tag": "section",
  "class": "sos-comic-section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Series / episode line" },
    { "type": "text", "id": "heading", "label": "Heading (H1)" },
    { "type": "richtext", "id": "standfirst", "label": "Standfirst" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "textarea", "id": "fiction_note", "label": "Fiction notice", "info": "Keeps drawn scenes clearly separate from real condition evidence." },
    { "type": "text", "id": "share_asset", "label": "Structured-data image", "info": "Theme asset filename for a wide landscape card. Falls back to the first scene." },
    { "type": "richtext", "id": "outro", "label": "Closing copy" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scene",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork (Shopify Files)" },
        { "type": "text", "id": "image_asset", "label": "Artwork (theme asset filename)", "info": "Used only when no Files image is chosen." },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Describe what happens in the scene, not just who is in it." },
        { "type": "text", "id": "scene_label", "label": "Scene label", "info": "For assistive tech, e.g. 'the listing looks perfect'." },

        { "type": "header", "content": "Bubble 1" },
        { "type": "text", "id": "bubble1_speaker", "label": "Speaker" },
        { "type": "textarea", "id": "bubble1_text", "label": "Dialogue" },
        { "type": "select", "id": "bubble1_pos", "label": "Placement", "default": "top-left",
          "options": [
            { "value": "top-left", "label": "Over artwork — top left" },
            { "value": "top-right", "label": "Over artwork — top right" },
            { "value": "bottom-left", "label": "Over artwork — bottom left" },
            { "value": "bottom-right", "label": "Over artwork — bottom right" },
            { "value": "below", "label": "Below the artwork" }
          ] },
        { "type": "checkbox", "id": "bubble1_tail", "label": "Show tail", "default": true },

        { "type": "header", "content": "Bubble 2" },
        { "type": "text", "id": "bubble2_speaker", "label": "Speaker" },
        { "type": "textarea", "id": "bubble2_text", "label": "Dialogue" },
        { "type": "select", "id": "bubble2_pos", "label": "Placement", "default": "bottom-right",
          "options": [
            { "value": "top-left", "label": "Over artwork — top left" },
            { "value": "top-right", "label": "Over artwork — top right" },
            { "value": "bottom-left", "label": "Over artwork — bottom left" },
            { "value": "bottom-right", "label": "Over artwork — bottom right" },
            { "value": "below", "label": "Below the artwork" }
          ] },
        { "type": "checkbox", "id": "bubble2_tail", "label": "Show tail", "default": true },

        { "type": "header", "content": "Bubble 3" },
        { "type": "text", "id": "bubble3_speaker", "label": "Speaker" },
        { "type": "textarea", "id": "bubble3_text", "label": "Dialogue" },
        { "type": "select", "id": "bubble3_pos", "label": "Placement", "default": "below",
          "options": [
            { "value": "top-left", "label": "Over artwork — top left" },
            { "value": "top-right", "label": "Over artwork — top right" },
            { "value": "bottom-left", "label": "Over artwork — bottom left" },
            { "value": "bottom-right", "label": "Over artwork — bottom right" },
            { "value": "below", "label": "Below the artwork" }
          ] },
        { "type": "checkbox", "id": "bubble3_tail", "label": "Show tail", "default": false },

        { "type": "header", "content": "Narration" },
        { "type": "textarea", "id": "narration", "label": "Caption", "info": "Optional line beneath the scene." }
      ]
    }
  ],
  "enabled_on": { "templates": ["article", "page"] },
  "presets": [{ "name": "Webcomic episode" }]
}
{% endschema %}
